int dx[4] = { -1,1,0,0 };
int dy[4] = { 0,0,1,-1 };
int n, m, ret, k;


//해당열에 그룹넣기
unordered_set<int> col[505];

unordered_map<int, int> sz;

int idx;
bool vis[505][505];
int arr[505][505];

void bfs(int a, int b, int g) {
	queue<pair<int, int>>q;
	q.push({ a,b });
	vis[a][b] = 1;

	
	int cnt = 0;
	while (!q.empty()) {
		int x = q.front().first;
		int y = q.front().second;
		q.pop();
		cnt++;
		col[y].insert(g);

		for (int i = 0; i < 4; i++) {
			int nx = x + dx[i];
			int ny = y + dy[i];
			if (nx < 0 || nx >= n || ny < 0 || ny >= m)
				continue;
			if (vis[nx][ny] || arr[nx][ny] == 0)
				continue;
			q.push({ nx,ny });
			vis[nx][ny] = 1;
		}
	}
	sz[g] = cnt;
}

int solution(vector<vector<int>> land) {
	n = land.size(), m = land[0].size();
	for (int i = 0; i < n; i++)
		for (int j = 0; j < m; j++)
			arr[i][j] = land[i][j];

	for (int i = 0; i < n; i++) {
		for (int j = 0; j < m; j++) {
			if (vis[i][j] == 0 && land[i][j] == 1) {
				bfs(i, j, idx++);
			}
		}
	}
	int answer = 0;
	for (int i = 0; i < m; i++) {
		int tmp = 0;
		for (auto c : col[i]) {
			tmp += sz[c];
		}
		answer = max(answer, tmp);
	}

	return answer;
}
