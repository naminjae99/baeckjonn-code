int solution(int h1, int m1, int s1,
	int h2, int m2, int s2) {

	int answer = 0;

	// 시작 / 종료 시간을 초 단위로 변환
	int startTime = h1 * 3600 + m1 * 60 + s1;
	int endTime = h2 * 3600 + m2 * 60 + s2;

	// 시작 시간이 00:00:00 또는 12:00:00 인 경우 미리 카운트
	if (startTime == 0 || startTime == 12 * 3600)
		answer++;

	while (startTime < endTime) {
		// 현재 각도
		double hCurAngle = fmod(startTime / 120.0, 360.0);
		double mCurAngle = fmod(startTime / 10.0, 360.0);
		double sCurAngle = fmod(startTime * 6.0, 360.0);

		// 다음 각도 (0도 → 360도 보정)
		double hNextAngle = fmod((startTime + 1) / 120.0, 360.0);
		double mNextAngle = fmod((startTime + 1) / 10.0, 360.0);
		double sNextAngle = fmod((startTime + 1) * 6.0, 360.0);

		if (hNextAngle == 0) hNextAngle = 360;
		if (mNextAngle == 0) mNextAngle = 360;
		if (sNextAngle == 0) sNextAngle = 360;

		// 초침 - 시침
		if (sCurAngle < hCurAngle && sNextAngle >= hNextAngle)
			answer++;

		// 초침 - 분침
		if (sCurAngle < mCurAngle && sNextAngle >= mNextAngle)
			answer++;

		// 시침·분침·초침 동시 겹침 중복 제거
		if (sNextAngle == hNextAngle && hNextAngle == mNextAngle)
			answer--;

		startTime++;
	}

	return answer;
}

