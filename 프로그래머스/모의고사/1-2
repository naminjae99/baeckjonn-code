using namespace std;
using ll = long long;

int n, m,ret;
int ord[10];
int arr[10][10];
int vis[10];

void dfs(int dep) {
	if (dep == m) {
		int sum = 0;
		for (int i = 0; i < m; i++) 
			sum += arr[ord[i]][i];
		
		ret = max(sum, ret);
		return;
	}

	for (int i = 0; i < n; i++){	
		if (vis[i])
			continue;
		ord[dep] = i;
		vis[i] = 1;
		dfs(dep + 1);
		vis[i] = 0;
	}
}
int solution(vector<vector<int>> ability) {
	n = ability.size();
	m = ability[0].size();

	for (int i = 0; i < n; i++)
		for (int j = 0; j < m; j++)
			arr[i][j] = ability[i][j];



	dfs(0);

	return ret;
}

