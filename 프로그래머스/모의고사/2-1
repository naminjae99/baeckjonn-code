int dy[4] = { 1,0,-1,0 };
int dx[4] = { 0,1,0,-1 };

int n, m,ret;

vector<int> solution(string command) {
	vector<int> answer;

	int x = 0; int y = 0;
	int dir = 0;

	for (auto c : command) {
		if (c == 'G') {
			x += dx[dir];
			y += dy[dir];
		}
		else if (c == 'R')
			dir = (dir + 1) % 4;
		else if (c == 'L')
			dir = (dir + 3) % 4;
		else {
			x += dx[(dir + 2) % 4];
			y += dy[(dir + 2) % 4];
		}
	}

   answer.push_back(x);
	answer.push_back(y);
 
	return answer;
}
