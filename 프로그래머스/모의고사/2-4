using ll = long long;


int dx[4] = { -1,1,0,0 };
int dy[4] = { 0,0,1,-1 };
int n, m, ret, k;

int arr[1005][1005];

struct f {
	int x, y, cnt;

};
queue<f>q;
int vis[1005][1005][2];

int solution(int n, int m, vector<vector<int>> hole) {
	memset(vis, -1, sizeof(vis));

	for (auto c : hole) 
		arr[c[1]][c[0]] = 1;

	q.push({ 1,1,0 });
	vis[1][1][0] = 0;

	while (!q.empty()){
		int x = q.front().x;
		int y = q.front().y;
		int cnt = q.front().cnt;
		q.pop();
	
		if (x == m && y == n) {
			return vis[x][y][cnt];
		}
		for (int i = 0; i < 4; i++) {
			int nx = x + dx[i];
			int ny = y + dy[i];
			if (nx<1 || nx>m || ny<1 || ny>n)
				continue;
			if (arr[nx][ny])
				continue;
		
			if (vis[nx][ny][cnt] != -1)
				continue;
			vis[nx][ny][cnt] = vis[x][y][cnt] + 1;
			q.push({ nx,ny,cnt });
		
		}
		if (cnt == 0) {
			for (int i = 0; i < 4; i++) {
				int nx = x + 2*dx[i];
				int ny = y + 2*dy[i];
				if (nx<1 || nx>m || ny<1 || ny>n)
					continue;
				if (arr[nx][ny])
					continue;

				if (vis[nx][ny][1] != -1)
					continue;
				vis[nx][ny][1] = vis[x][y][cnt] + 1;
				q.push({ nx,ny,1 });
			}
		}

	}


	return -1;
}

