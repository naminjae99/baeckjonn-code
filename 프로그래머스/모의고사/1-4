using namespace std;
using ll = long long;

int n, m,ret;

ll now;
struct f {
	int pr, come, during;
	bool operator<(const f& o)const {
		if (pr != o.pr)
			return pr > o.pr;
		return come > o.come;
	}
};
priority_queue<f>q;

bool cmp(vector<int> a,vector<int> b) {
	return a[1] < b[1];
}
vector<long long> solution(vector<vector<int>> program) {
	n = program.size();
	sort(program.begin(), program.end(), cmp);


	vector<long long> answer(11);

	now = program[0][1];
	q.push({ program[0][0],program[0][1] ,program[0][2] });
	int idx = 1;

	int cnt = 0;

	while (1) {

		for (int i = idx; i < n; i++) {
			if (program[i][1] <= now) {
				q.push({ program[i][0],program[i][1] ,program[i][2] });
				idx++;
			}
			else 
				break;
		}

		if (q.empty()) {
			now = program[idx][1];
			continue;
		}

		int pr = q.top().pr;
		int come = q.top().come;
		int during = q.top().during;
		q.pop();



		answer[pr] += (now - (ll)come);
		now += (ll)during;
		
		cnt++;
		if (cnt == n) {
			answer[0] = now;
			break;
		}
	}



	return answer;
}
