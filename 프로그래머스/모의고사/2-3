int dx[8] = { -1,-1,-1,0,0,1,1,1 };
int dy[8] = { -1,0,1,-1,1,-1,0,1 };
int n, m, ret, k;

queue<int> q;

int solution(vector<int> menu, vector<int> order, int k) {
	n = order.size();

	int answer = 1;

	int cur = 0;
	q.push(0);

	int idx = 1;


	while (!q.empty()) {
		int p = q.front();
		int o = order[p];
		int t = menu[o];

		cur += t;

	
		for (int i = idx; i < n; i++) {
			if (i*k <cur) {
				q.push(i);
				idx++;
			}
			else 
				break;
			
		}

		//다 만들기전에 들어온사람
		answer = max(answer, (int)q.size());


		q.pop();
		

		if (q.empty()&&idx<n) {
			cur = idx * k;
			q.push(idx++);
		}
		if (idx >= n)
			break;
	}



	return answer;
}

